# Bidwraith front controller.
#
# The app is deployed at https://app.brunovidasi.com/bidwraith, i.e. a subfolder of
# the app.brunovidasi.com document root (public_html/app). Only public/ may ever be
# reachable over HTTP — config/, includes/, cron/, sql/ and data/ must not be.
#
# Rather than flattening the project to suit the host, every request is mapped into
# public/. That keeps the layout on the server byte-identical to the repo, so there
# is no dev/prod drift and no rewritten require paths.
#
# Note: mod_rewrite rules in a parent .htaccess are NOT inherited once a directory
# declares its own RewriteEngine On, so the SPA fallback rules in public_html's
# .htaccess do not apply here.

Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Must match the URL path this app is mounted at.
    RewriteBase /bidwraith/

    # Force HTTPS. The second condition covers a proxy terminating TLS upstream,
    # which would otherwise leave %{HTTPS} off and cause a redirect loop.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Send anyone who reaches for /bidwraith/public/... to the canonical URL.
    # THE_REQUEST holds the original request line and is untouched by the internal
    # rewrite below, so this only fires for a real client request, never for our own.
    RewriteCond %{THE_REQUEST} \s/bidwraith/public/ [NC]
    RewriteRule ^public/(.*)$ /bidwraith/$1 [L,R=301]

    # Stop condition. In per-directory context the ruleset re-runs after a rewrite,
    # so without this the path would grow public/public/public/... until Apache
    # gives up with a 500.
    RewriteRule ^public/ - [L]

    # Pretty URLs. Every page link in the app is written without .php, so this is
    # the rule that actually serves them: /bidwraith/dashboard -> public/dashboard.php.
    # The -f test means an unknown name falls through to the 404 below rather than
    # being rewritten onto a PHP file that isn't there.
    RewriteCond %{DOCUMENT_ROOT}/bidwraith/public/$1.php -f
    RewriteRule ^([A-Za-z0-9_]+)$ public/$1.php [L]

    # Canonicalise the old .php URLs (bookmarks, links already sent out) onto the
    # extensionless ones. Restricted to GET because a 301 tells the client to redo
    # the request as a GET, which would silently drop the body of a POST.
    #
    # The excluded endpoints are not ours to rename: ebay_callback and ebay_deletion
    # are registered in the eBay developer console, stripe_webhook in the Stripe
    # dashboard, and cron_http is baked into the host's cron entry. They keep
    # answering on their .php URL.
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteRule ^(?!ebay_callback|ebay_deletion|cron_http|stripe_webhook)([A-Za-z0-9_]+)\.php$ /bidwraith/$1 [L,R=301,NE]

    # Everything else is served from public/.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Error pages, styled like the rest of the app. These are URL paths, so they go
# back through the rewrites above and land on public/404.php and public/500.php.
# Apache only raises a 500 itself; a PHP fatal is caught by the shutdown handler
# in includes/runtime.php, which renders the same page.
ErrorDocument 404 /bidwraith/404
ErrorDocument 500 /bidwraith/500

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Defence in depth: even if mod_rewrite is unavailable, the SQLite database must
# never be downloadable. data/ also carries its own deny-all .htaccess.
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|sqlite-journal|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
