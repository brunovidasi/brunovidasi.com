# ProgrammerTime front controller.
#
# Deployed at https://app.brunovidasi.com/programmertime, i.e. a subfolder of the
# app.brunovidasi.com document root (public_html/app). There is no RewriteBase:
# relative substitutions resolve against this directory, so the same file works
# at a site root locally and in the subfolder on the server.
#
# Only index.php and the static files under assets/ are meant to be reachable.
# application/ and system/ also carry their own deny-all .htaccess.

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS, except on a local machine. The X-Forwarded-Proto condition
    # covers a proxy terminating TLS upstream, which would otherwise loop.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Framework code, the local database, the schemas and repo notes are never served. Nor is any
    # PHP file other than the front controller: config files and mPDF are only
    # ever include()d, and this also stops an uploaded script from executing.
    RewriteRule ^(application|system|data)(/|$) - [F,L]
    RewriteRule ^(schema\.sql|README\.md|\.git.*)$ - [F,L,NC]
    RewriteRule ^(?!index\.php$).*\.(php[0-9]?|phtml|phar)$ - [F,L,NC]

    # Remove "index.php" from URLs: everything that isn't a real file goes
    # through CodeIgniter.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?/$1 [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Defence in depth if mod_rewrite is unavailable.
<FilesMatch "\.(sql|md|txt|log|sqlite|sqlite-journal|sqlite-wal|sqlite-shm|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
